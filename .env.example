NODE_ENV=development
PORT=5000

# MongoDB Atlas
DATABASE=mongodb+srv://DATABASE_USER:<PASSWORD>@CLUSTER_HOST/DATABASE_NAME
DATABASE_PASSWORD=replace-with-database-password

# Authentication
JWT_SECRET=replace-with-a-long-random-secret

# Cloudinary
CLOUD_NAME=replace-with-cloud-name
CLOUD_API_KEY=replace-with-api-key
CLOUD_API_SECRET=replace-with-api-secret

# Public frontend and allowed browser origins
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Email notifications
EMAIL_USER=replace-with-email-address
EMAIL_PASS=replace-with-email-app-password

# Twilio notifications
TWILIO_SID=replace-with-account-sid
TWILIO_AUTH_TOKEN=replace-with-auth-token
TWILIO_PHONE=replace-with-sms-number
TWILIO_WHATSAPP_NUMBER=replace-with-whatsapp-number
